<Window x:Class="DbViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로테크 로그 뷰어"
        Width="1080"
        Height="1000"
        MinWidth="1080"
        MinHeight="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Grid>
        <!-- 배경 이미지: Build Action = Resource 필요 -->
        <Image Source="/Assets/Images/Background.png"
               Stretch="UniformToFill"
               Opacity="1"/>

        <!-- 밝기 보정 오버레이 -->
        <Border Background="#55FFFFFF"/>

        <!-- 메인 글래스 컨테이너 -->
        <Border Margin="24"
                CornerRadius="28"
                Background="#DDFBFDFF"
                BorderBrush="#E8F1FF"
                BorderThickness="1"
                Padding="22">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.18"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="52"
                                Height="52"
                                CornerRadius="16"
                                Background="#FF5A3D"
                                Margin="0,0,16,0">
                            <TextBlock Text="🔥"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="프로테크 로그 뷰어"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="#0E2448"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Action Button Bar: 화면 폭에 맞게 6개 버튼 균등 분배 -->
                <Border Grid.Row="1"
                        Background="#BFFFFFFF"
                        CornerRadius="22"
                        BorderBrush="#E4ECF7"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,12">

                    <UniformGrid Columns="6"
                                 Rows="1">

                        <Border Background="#FF5A3D"
                                CornerRadius="16"
                                Padding="12,13"
                                Margin="4">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="🗄"
                                           FontSize="20"
                                           Foreground="White"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="DB 선택"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FCFF"
                                CornerRadius="16"
                                Padding="12,13"
                                Margin="4"
                                BorderBrush="#DDE7F5"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="📂"
                                           FontSize="20"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="DB 보기"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#102044"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FCFF"
                                CornerRadius="16"
                                Padding="12,13"
                                Margin="4"
                                BorderBrush="#DDE7F5"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="↩"
                                           FontSize="23"
                                           Foreground="#FF5A3D"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="DB 복구"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#102044"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FCFF"
                                CornerRadius="16"
                                Padding="12,13"
                                Margin="4"
                                BorderBrush="#DDE7F5"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="＋"
                                           FontSize="23"
                                           Foreground="#00A66A"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="보고서 저장"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#0C7A51"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FCFF"
                                CornerRadius="16"
                                Padding="12,13"
                                Margin="4"
                                BorderBrush="#DDE7F5"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="🖨"
                                           FontSize="20"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="인쇄"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#7546E8"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F9FCFF"
                                CornerRadius="16"
                                Padding="12,13"
                                Margin="4"
                                BorderBrush="#DDE7F5"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="↻"
                                           FontSize="23"
                                           Foreground="#1467F2"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="새로고침"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#1467F2"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Border>

                <!-- Body -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 검색 조건 -->
                    <Border Grid.Row="0"
                            Background="#BFFFFFFF"
                            CornerRadius="20"
                            BorderBrush="#E4ECF7"
                            BorderThickness="1"
                            Padding="16"
                            Margin="0,0,0,10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 날짜 조건: 폭에 따라 입력칸도 같이 늘어남 -->
                            <Grid Grid.Row="0"
                                  Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="시작일"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#102044"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Border Grid.Column="1"
                                        Background="#F9FCFF"
                                        BorderBrush="#DDE7F5"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,9"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="2026-06-01"
                                               FontSize="14"
                                               Foreground="#102044"/>
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="종료일"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#102044"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Border Grid.Column="3"
                                        Background="#F9FCFF"
                                        BorderBrush="#DDE7F5"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,9"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="2026-06-04"
                                               FontSize="14"
                                               Foreground="#102044"/>
                                </Border>

                                <Border Grid.Column="4"
                                        Background="#FF5A3D"
                                        CornerRadius="14"
                                        Padding="20,10"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="기간 조회"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <UniformGrid Grid.Column="5"
                                             Columns="4"
                                             Rows="1">
                                    <Border Background="#F9FCFF"
                                            CornerRadius="12"
                                            BorderBrush="#DDE7F5"
                                            BorderThickness="1"
                                            Padding="10,9"
                                            Margin="3">
                                        <TextBlock Text="오늘"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#23395D"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Background="#F9FCFF"
                                            CornerRadius="12"
                                            BorderBrush="#DDE7F5"
                                            BorderThickness="1"
                                            Padding="10,9"
                                            Margin="3">
                                        <TextBlock Text="최근 7일"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#23395D"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Background="#F9FCFF"
                                            CornerRadius="12"
                                            BorderBrush="#DDE7F5"
                                            BorderThickness="1"
                                            Padding="10,9"
                                            Margin="3">
                                        <TextBlock Text="이번 달"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#23395D"
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <Border Background="#EEF5FF"
                                            CornerRadius="12"
                                            BorderBrush="#D7E7FF"
                                            BorderThickness="1"
                                            Padding="10,9"
                                            Margin="3">
                                        <TextBlock Text="전체"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="#1467F2"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </Grid>

                            <!-- 검색 조건: 검색어 칸이 화면에 맞춰 늘어남 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="2.8*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="검색 기준"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#102044"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Border Grid.Column="1"
                                        Background="#F9FCFF"
                                        BorderBrush="#DDE7F5"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,9"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="전체"
                                               FontSize="14"
                                               Foreground="#102044"/>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#F9FCFF"
                                        BorderBrush="#DDE7F5"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,9"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="검색어를 입력하세요"
                                               FontSize="14"
                                               Foreground="#9AA6BA"/>
                                </Border>

                                <Border Grid.Column="3"
                                        Background="#FF5A3D"
                                        CornerRadius="14"
                                        Padding="26,10"
                                        Margin="0,0,10,0">
                                    <TextBlock Text="검색"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>

                                <Border Grid.Column="4"
                                        Background="#F9FCFF"
                                        CornerRadius="14"
                                        BorderBrush="#DDE7F5"
                                        BorderThickness="1"
                                        Padding="24,10">
                                    <TextBlock Text="초기화"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#23395D"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 통계 + 필터 버튼: 1080 폭에 맞춰 9개 균등 분배 -->
                    <Border Grid.Row="1"
                            Background="#BFFFFFFF"
                            CornerRadius="20"
                            BorderBrush="#E4ECF7"
                            BorderThickness="1"
                            Padding="10"
                            Margin="0,0,0,10">

                        <UniformGrid Columns="9"
                                     Rows="1">

                            <Border Background="#EEF5FF"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#D7E7FF"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="전체 로그"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="52,341"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#1467F2"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF5F3"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#FFE0DA"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="화재"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="34"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#FF3B30"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F7FAFF"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#D7E7FF"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="제경보"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="18"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#1467F2"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF8ED"
                                    CornerRadius="15"
                                    Padding="6,10"
                                    Margin="4"
                                    BorderBrush="#FFE8C6"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="중계기 고장"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="76"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#F05A00"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF8ED"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#FFE8C6"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="AN 고장"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="9"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#F05A00"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFF8ED"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#FFE8C6"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="단선"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="128"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#F07800"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F0FFFC"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#CDEFEA"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="출력"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="41"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#008C86"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F5F0FF"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#E2D4FF"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MCC"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="12"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#7C3FE8"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F9FCFF"
                                    CornerRadius="15"
                                    Padding="8,10"
                                    Margin="4"
                                    BorderBrush="#DDE7F5"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="기타"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="23"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#6B7892"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <!-- 로그 테이블: 모든 컬럼이 비율로 같이 늘어남 -->
                    <Border Grid.Row="2"
                            Background="#CCFFFFFF"
                            CornerRadius="20"
                            BorderBrush="#E4ECF7"
                            BorderThickness="1"
                            Margin="0,0,0,10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Background="#EEF4FB">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.0*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="발생시간" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="구분" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="상태" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="위치" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="내용" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="패킷" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>

                                    <Grid Height="42"
                                          Background="#FFFFFF">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2.4*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="2026-06-04 10:28" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#102044"/>
                                        <TextBlock Grid.Column="1" Text="🔥 화재" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF3B30" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="발생" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF3B30" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="지하 1층 주차장" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#102044" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="연기 감지기 화재 발생" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#102044" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="5" Text="10 02 01 01 7A 3C" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#263A5E" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <Grid Height="42"
                                          Background="#F8FBFF">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2.4*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="2026-06-04 10:28" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#102044"/>
                                        <TextBlock Grid.Column="1" Text="🔔 제경보" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1467F2" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="발생" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF3B30" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="3층 복도" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#102044" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="수동발신기 제경보 발생" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#102044" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="5" Text="10 02 03 02 68 2F" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#263A5E" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <Grid Height="42"
                                          Background="#FFFFFF">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.0*"/>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2.4*"/>
                                            <ColumnDefinition Width="1.8*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="2026-06-04 10:26" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#102044"/>
                                        <TextBlock Grid.Column="1" Text="🔗 단선" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F07800" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2" Text="발생" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF3B30" FontWeight="Bold"/>
                                        <TextBlock Grid.Column="3" Text="옥상층" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#102044" TextTrimming="CharacterEllipsis"/>
