<Window x:Class="DbViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로테크 로그 뷰어"
        Width="1080"
        Height="1000"
        MinWidth="1080"
        MinHeight="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">

    <Window.Resources>

        <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#92FFFFFF" Offset="0"/>
            <GradientStop Color="#78EEF6FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassSubPanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#96F8FBFF" Offset="0"/>
            <GradientStop Color="#78E3EEFA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#CCFFFFFF" Offset="0"/>
            <GradientStop Color="#9BEAF3FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFF6B52" Offset="0"/>
            <GradientStop Color="#FFFF3F2D" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RealGlassButtonFillBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B8FFFFFF" Offset="0"/>
            <GradientStop Color="#8DEAF4FF" Offset="0.55"/>
            <GradientStop Color="#72DCEBFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RealGlassButtonHighlightBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#95FFFFFF" Offset="0"/>
            <GradientStop Color="#45FFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RealGlassPrimaryFillBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFF735C" Offset="0"/>
            <GradientStop Color="#FFFF5A43" Offset="0.55"/>
            <GradientStop Color="#FFF84634" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RealGlassPrimaryHighlightBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#80FFFFFF" Offset="0"/>
            <GradientStop Color="#30FFFFFF" Offset="0.45"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TablePanelBrush" Color="#E8FFFFFF"/>
        <SolidColorBrush x:Key="TableHeaderBrush" Color="#EEF3FA"/>
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#CFE3F2FF"/>
        <SolidColorBrush x:Key="SoftBorderBrush" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="RealGlassStrokeBrush" Color="#B8FFFFFF"/>
        <SolidColorBrush x:Key="RealGlassInnerStrokeBrush" Color="#55FFFFFF"/>

        <DropShadowEffect x:Key="GlassShadow"
                          BlurRadius="30"
                          ShadowDepth="0"
                          Opacity="0.18"
                          Color="#5F83A5"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="16"
                          ShadowDepth="0"
                          Opacity="0.13"
                          Color="#6F8FAF"/>

        <DropShadowEffect x:Key="PrimaryButtonShadow"
                          BlurRadius="20"
                          ShadowDepth="0"
                          Opacity="0.22"
                          Color="#CC6A4A"/>

        <DropShadowEffect x:Key="RealGlassButtonShadow"
                          BlurRadius="24"
                          ShadowDepth="0"
                          Opacity="0.24"
                          Color="#6687A8"/>

        <DropShadowEffect x:Key="RealGlassPrimaryShadow"
                          BlurRadius="26"
                          ShadowDepth="0"
                          Opacity="0.30"
                          Color="#D66A4D"/>

        <Style x:Key="GlassPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
        </Style>

        <Style x:Key="GlassSubPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassSubPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource GlassShadow}"/>
        </Style>

        <Style x:Key="GlassButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPrimaryButtonBrush}"/>
            <Setter Property="BorderBrush" Value="#DDFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect" Value="{StaticResource PrimaryButtonShadow}"/>
        </Style>

        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#BFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#E6FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">

        <Image Source="/Assets/Images/Background.png"
               Stretch="UniformToFill"
               Opacity="0.88">
            <Image.Effect>
                <BlurEffect Radius="12"/>
            </Image.Effect>
        </Image>

        <Image Source="/Assets/Images/Background.png"
               Stretch="UniformToFill"
               Opacity="0.28"/>

        <Border Background="#56F7FAFF"/>

        <Border Margin="24"
                Style="{StaticResource GlassPanelStyle}"
                CornerRadius="28"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="52"
                                Height="52"
                                CornerRadius="16"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,16,0">
                            <TextBlock Text="🔥"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="프로테크 이력 보기"
                                   FontSize="31"
                                   FontWeight="Bold"
                                   Foreground="#0E2448"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource GlassSubPanelStyle}"
                        CornerRadius="22"
                        Padding="12"
                        Margin="0,0,0,12">

                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.35*"/>
                            <ColumnDefinition Width="0.35*"/>
                            <ColumnDefinition Width="0.35*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                x:Name="HistoryViewButton"
                                MinWidth="1"
                                Height="54"
                                CornerRadius="18"
                                Margin="4,5,10,5"
                                BorderBrush="{StaticResource RealGlassStrokeBrush}"
                                BorderThickness="1"
                                Effect="{StaticResource RealGlassPrimaryShadow}"
                                Cursor="Hand">
                            <Grid>
                                <Border CornerRadius="18"
                                        Background="{StaticResource RealGlassPrimaryFillBrush}"/>
                                <Border CornerRadius="18"
                                        Margin="1"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"/>
                                <Border CornerRadius="18,18,10,10"
                                        Height="21"
                                        Margin="1,1,1,0"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource RealGlassPrimaryHighlightBrush}"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="▣"
                                               FontSize="18"
                                               Foreground="White"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="이력 보기"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                x:Name="HistoryRecoverButton"
                                MinWidth="130"
                                Height="54"
                                CornerRadius="18"
                                Margin="0,5,10,5"
                                BorderBrush="{StaticResource RealGlassStrokeBrush}"
                                BorderThickness="1"
                                Effect="{StaticResource RealGlassButtonShadow}"
                                Cursor="Hand">
                            <Grid>
                                <Border CornerRadius="18"
                                        Background="{StaticResource RealGlassButtonFillBrush}"/>
                                <Border CornerRadius="18"
                                        Margin="1"
                                        BorderBrush="{StaticResource RealGlassInnerStrokeBrush}"
                                        BorderThickness="1"/>
                                <Border CornerRadius="18,18,10,10"
                                        Height="21"
                                        Margin="1,1,1,0"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource RealGlassButtonHighlightBrush}"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="↩"
                                               FontSize="22"
                                               Foreground="#FF5A3D"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="이력 복구"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                x:Name="FileSaveButton"
                                MinWidth="130"
                                Height="54"
                                CornerRadius="18"
                                Margin="0,5,10,5"
                                BorderBrush="{StaticResource RealGlassStrokeBrush}"
                                BorderThickness="1"
                                Effect="{StaticResource RealGlassButtonShadow}"
                                Cursor="Hand">
                            <Grid>
                                <Border CornerRadius="18"
                                        Background="{StaticResource RealGlassButtonFillBrush}"/>
                                <Border CornerRadius="18"
                                        Margin="1"
                                        BorderBrush="{StaticResource RealGlassInnerStrokeBrush}"
                                        BorderThickness="1"/>
                                <Border CornerRadius="18,18,10,10"
                                        Height="21"
                                        Margin="1,1,1,0"
                                        VerticalAlignment="Top"
                                        Background="{StaticResource RealGlassButtonHighlightBrush}"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🖨"
                                               FontSize="18"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="파일 저장"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#102044"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource GlassSubPanelStyle}"
                            CornerRadius="20"
                            Padding="16"
                            Margin="0,0,0,10">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="0.70*"/>
                                <ColumnDefinition Width="0.70*"/>
                                <ColumnDefinition Width="0.70*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="시작일"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#102044"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    x:Name="StartDateButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    CornerRadius="14"
                                    Padding="14,9"
                                    Margin="0,0,18,0"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="StartDateText"
                                               Grid.Column="0"
                                               Text=""
                                               FontSize="16"
                                               Foreground="#263A5E"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock x:Name="StartDateArrowText"
                                               Grid.Column="1"
                                               Text="▼"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#5D6F8A"
                                               VerticalAlignment="Center"
                                               Margin="10,1,0,0"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="종료일"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#102044"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <Border Grid.Row="0"
                                    Grid.Column="3"
                                    x:Name="EndDateButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    CornerRadius="14"
                                    Padding="14,9"
                                    Margin="0,0,10,0"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="EndDateText"
                                               Grid.Column="0"
                                               Text=""
                                               FontSize="16"
                                               Foreground="#263A5E"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock x:Name="EndDateArrowText"
                                               Grid.Column="1"
                                               Text="▼"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#5D6F8A"
                                               VerticalAlignment="Center"
                                               Margin="10,1,0,0"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="4"
                                    x:Name="PeriodSearchButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    CornerRadius="14"
                                    Height="42"
                                    Margin="0,0,10,0"
                                    Cursor="Hand">
                                <TextBlock Text="기간 조회"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="5"
                                    x:Name="AllPeriodButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Background="#D8F2F8FF"
                                    CornerRadius="14"
                                    Height="42"
                                    Margin="0,0,8,0"
                                    Cursor="Hand">
                                <TextBlock Text="전체"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#1467F2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="6"
                                    x:Name="SevenDaysButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    CornerRadius="14"
                                    Height="42"
                                    Margin="0,0,8,0"
                                    Cursor="Hand">
                                <TextBlock Text="7일"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#23395D"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="7"
                                    x:Name="ThirtyDaysButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    CornerRadius="14"
                                    Height="42"
                                    Margin="0,0,8,0"
                                    Cursor="Hand">
                                <TextBlock Text="30일"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#23395D"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="검색창"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#102044"
                                       VerticalAlignment="Center"
                                       Margin="0,12,10,0"/>

                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Style="{StaticResource GlassButtonStyle}"
                                    CornerRadius="14"
                                    Padding="14,9"
                                    Margin="0,12,10,0">

                                <Grid>
                                    <TextBox x:Name="SearchKeywordTextBox"
                                                     FontSize="14"
                                                     Foreground="#263A5E"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalContentAlignment="Center"
                                                     Padding="0,0,34,0"/>

                                    <Border x:Name="SearchClearButton"
                                            Width="26"
                                            Height="26"
                                            CornerRadius="13"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="#66FFFFFF"
                                            BorderBrush="#B8C9D8E8"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <TextBlock Text="×"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="#5D6F8A"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-5,0,0"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="4"
                                    x:Name="SearchButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    CornerRadius="14"
                                    Height="42"
                                    Margin="0,12,10,0"
                                    Cursor="Hand">
                                <TextBlock Text="검색"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="5"
                                    x:Name="Keyboard"
                                    Style="{StaticResource GlassButtonStyle}"
                                    CornerRadius="14"
                                    Height="42"
                                    Margin="0,12,8,0"
                                    Cursor="Hand">
                                <TextBlock Text="키보드 복구"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#23395D"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.Column="7"
                                    Grid.ColumnSpan="2"
                                    x:Name="ModeToggleButton"
                                    Style="{StaticResource GlassButtonStyle}"
                                    CornerRadius="14"
                                    Height="42"
                                    Margin="0,12,0,0"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="↕"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#FF5A3D"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ModeToggleText"
                                               Text="필터 모드"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#23395D"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource GlassSubPanelStyle}"
                            CornerRadius="20"
                            Padding="10"
                            Margin="0,0,0,10">

                        <UniformGrid Columns="9" Rows="1">

                            <Border Style="{StaticResource StatCardStyle}" x:Name="TotalLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="전체 로그" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TotalLogCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#1467F2" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="FireLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="화재" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="FireCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#FF3B30" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="AlarmLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="제경보" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AlarmCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#1467F2" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="RelayErrorLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="중계기 고장" FontSize="11" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="RelayErrorCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#7C3FE8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="AnErrorLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="AN 고장" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AnErrorCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#F05A00" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="LineBreakLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="단선" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="LineBreakCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#F07800" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="OutputLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="출력" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="OutputCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#008C86" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="MccLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="MCC" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="MccCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#7C3FE8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource StatCardStyle}" x:Name="EtcLogButton" Cursor="Hand">
                                <StackPanel>
                                    <TextBlock Text="기타" FontSize="12" FontWeight="Bold" Foreground="#102044" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EtcCountText" Text="0" FontSize="21" FontWeight="Bold" Foreground="#6B7892" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                        </UniformGrid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource TablePanelBrush}"
                            BorderBrush="#E6FFFFFF"
                            BorderThickness="1"
                            CornerRadius="20"
                            Margin="0,0,0,10"
                            ClipToBounds="True">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 발생시간 고정 컬럼 -->
                                <ColumnDefinition Width="168"/>

                                <!-- 구분/상태/위치/내용/패킷 터치 스크롤 영역 -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 왼쪽 고정 헤더: 발생시간 -->
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="{StaticResource TableHeaderBrush}"
                                    CornerRadius="20,0,0,0"
                                    BorderBrush="#DDE8F2"
                                    BorderThickness="0,0,1,1">

                                <TextBlock Text="발생시간"
                                           FontWeight="Bold"
                                           Foreground="#102044"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- 오른쪽 헤더: 본문 가로 이동과 같이 움직임 -->
                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Background="{StaticResource TableHeaderBrush}"
                                    CornerRadius="0,20,0,0"
                                    BorderBrush="#DDE8F2"
                                    BorderThickness="0,0,0,1"
                                    ClipToBounds="True">

                                <ScrollViewer x:Name="HeaderHorizontalScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              Background="Transparent"
                                              PanningMode="HorizontalOnly">

                                    <Grid x:Name="ScrollableHeaderGrid"
                                          Width="930"
                                          Height="44">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="380"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="구분"
                                                   FontWeight="Bold"
                                                   Foreground="#102044"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1"
                                                   Text="상태"
                                                   FontWeight="Bold"
                                                   Foreground="#102044"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="위치"
                                                   FontWeight="Bold"
                                                   Foreground="#102044"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3"
                                                   Text="내용"
                                                   FontWeight="Bold"
                                                   Foreground="#102044"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4"
                                                   Text="코드"
                                                   FontWeight="Bold"
                                                   Foreground="#102044"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!-- 왼쪽 고정 발생시간 목록 -->
                            <ScrollViewer x:Name="FixedTimeScrollViewer"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Background="Transparent"
                                          Focusable="False">

                                <StackPanel x:Name="FixedTimeRowsPanel"/>
                            </ScrollViewer>

                            <!-- 오른쪽 터치 스크롤 목록 -->
                            <ScrollViewer x:Name="LogScrollViewer"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Hidden"
                                          Background="Transparent"
                                          PanningMode="Both"
                                          PanningRatio="1.5"
                                          PanningDeceleration="0.001"
                                          CanContentScroll="False"
                                          ManipulationBoundaryFeedback="LogScrollViewer_ManipulationBoundaryFeedback">

                                <ScrollViewer.Resources>

                                    <!-- 세로 스크롤바 전체 폭 -->
                                   
                                    <Style TargetType="{x:Type ScrollBar}">
                                        <Setter Property="Width" Value="22"/>
                                        <Setter Property="MinWidth" Value="22"/>
                                        <Setter Property="Background" Value="#EEF3FA"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </Style>

                                    <Style TargetType="{x:Type Thumb}">
                                        <Setter Property="MinHeight" Value="120"/>
                                    </Style>
                                </ScrollViewer.Resources>

                                <StackPanel x:Name="LogRowsPanel"
                                            Width="930"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Style="{StaticResource GlassSubPanelStyle}"
                            CornerRadius="20"
                            Padding="16">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="1"
                                        x:Name="PaginationPanel"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                       x:Name="TotalPageInfoText"
                                       Text="총 1페이지 · 0건"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#506078"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"/>

                            <Grid Grid.Column="3">
                                <Border x:Name="PageSizeButton"
                                        Width="118"
                                        Height="40"
                                        CornerRadius="12"
                                        BorderBrush="{StaticResource RealGlassStrokeBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource RealGlassButtonFillBrush}"
                                        Effect="{StaticResource RealGlassButtonShadow}"
                                        Cursor="Hand">

                                    <Grid>
                                        <Border CornerRadius="12"
                                                Margin="1"
                                                BorderBrush="{StaticResource RealGlassInnerStrokeBrush}"
                                                BorderThickness="1"/>

                                        <Border CornerRadius="12,12,8,8"
                                                Height="16"
                                                Margin="1,1,1,0"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource RealGlassButtonHighlightBrush}"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="PageSizeText"
                                                       Text="1,000건"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#23395D"
                                                       Margin="0,0,6,0"
                                                       VerticalAlignment="Center"/>

                                            <TextBlock Text="▲"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#23395D"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Border>

        <Border x:Name="PageSizeDropdown"
                Width="150"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,58,94"
                CornerRadius="16"
                Background="#F7FFFFFF"
                BorderBrush="#E6FFFFFF"
                BorderThickness="1"
                Padding="8"
                Visibility="Collapsed"
                Panel.ZIndex="999"
                Effect="{StaticResource RealGlassButtonShadow}">

            <StackPanel>
                <Border x:Name="PageSize1000Button" Height="42" CornerRadius="12" Cursor="Hand" Margin="0,0,0,4">
                    <TextBlock Text="1,000건" FontSize="15" FontWeight="Bold" Foreground="#23395D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="PageSize5000Button" Height="42" CornerRadius="12" Cursor="Hand" Margin="0,0,0,4">
                    <TextBlock Text="5,000건" FontSize="15" FontWeight="Bold" Foreground="#23395D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="PageSize10000Button" Height="42" CornerRadius="12" Cursor="Hand" Margin="0,0,0,4">
                    <TextBlock Text="10,000건" FontSize="15" FontWeight="Bold" Foreground="#23395D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="PageSize50000Button" Height="42" CornerRadius="12" Cursor="Hand" Margin="0,0,0,4">
                    <TextBlock Text="50,000건" FontSize="15" FontWeight="Bold" Foreground="#23395D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border x:Name="PageSize100000Button" Height="42" CornerRadius="12" Cursor="Hand">
                    <TextBlock Text="100,000건" FontSize="15" FontWeight="Bold" Foreground="#23395D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="DateCalendarDropdown"
                Width="360"
                Height="320"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Panel.ZIndex="1000"
                Background="#FCFFFFFF"
                BorderBrush="#D7E4F2"
                BorderThickness="1"
                CornerRadius="18"
                ClipToBounds="True"
                SnapsToDevicePixels="True"
                Effect="{StaticResource RealGlassButtonShadow}">

            <Border.RenderTransform>
                <TranslateTransform x:Name="DateCalendarDropdownTransform"/>
            </Border.RenderTransform>

            <Viewbox Stretch="Fill">
                <Calendar x:Name="DateCalendar"
                          Width="205"
                          Height="175"
                          SelectionMode="SingleDate"
                          FirstDayOfWeek="Sunday"
                          FontSize="15"
                          Background="#FCFFFFFF"
                          BorderBrush="Transparent"
                          BorderThickness="0"/>
            </Viewbox>
        </Border>
        <Border x:Name="HistoryOpenChoiceOverlay"
        Background="#66000000"
        Visibility="Collapsed"
        Panel.ZIndex="2000">

            <Grid>
                <Border Width="420"
                Height="300"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="24"
                Background="#F8FFFFFF"
                BorderBrush="#E6FFFFFF"
                BorderThickness="1"
                Padding="24">

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="이력 파일 열기"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#0E2448"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                        <TextBlock Text="이력을 여는 방법을 선택하세요."
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#506078"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                        <!-- 파일 선택 -->
                        <Border x:Name="ManualHistoryFileButton"
                        Height="54"
                        CornerRadius="17"
                        Margin="0,0,0,12"
                        BorderBrush="{StaticResource RealGlassStrokeBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource RealGlassButtonShadow}"
                        Cursor="Hand">

                            <Grid>
                                <Border CornerRadius="17"
                                Background="{StaticResource RealGlassButtonFillBrush}"/>

                                <Border CornerRadius="17"
                                Margin="1"
                                BorderBrush="{StaticResource RealGlassInnerStrokeBrush}"
                                BorderThickness="1"/>

                                <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="📁"
                                       FontSize="18"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>

                                    <TextBlock Text="파일 선택"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#102044"
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 파일 자동 탐색 -->
                        <Border x:Name="AutoHistoryFileButton"
                        Height="54"
                        CornerRadius="17"
                        Margin="0,0,0,12"
                        BorderBrush="{StaticResource RealGlassStrokeBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource RealGlassPrimaryShadow}"
                        Cursor="Hand">

                            <Grid>
                                <Border CornerRadius="17"
                                Background="{StaticResource RealGlassPrimaryFillBrush}"/>

                                <Border CornerRadius="17"
                                Margin="1"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1"/>

                                <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="🔍"
                                       FontSize="18"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>

                                    <TextBlock Text="파일 자동 탐색"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 취소 -->
                        <Border x:Name="CancelHistoryOpenButton"
                        Height="46"
                        CornerRadius="15"
                        Background="#ECF2F8"
                        BorderBrush="#D8E4F0"
                        BorderThickness="1"
                        Cursor="Hand">

                            <TextBlock Text="취소"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#506078"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>